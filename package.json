{
	"name": "aws-events",
	"version": "0.0.0",
	"description": "Collection of JSON Schemas for AWS Lambda Events",
	"type": "module",
	"main": "$defs.json",
	"files": [
		"$defs.json",
		"events/"
	],
	"exports": {
		".": "./$defs.json",
		"./$defs.json": "./$defs.json",
		"./events/*": "./events/*"
	},
	"scripts": {
		"test": "npm run test:lint && npm run test:unit && npm run test:types && npm run test:sast",
		"prepare": "husky",
		"git:pre-commit": "npm run git:lint-staged && npm run git:test-staged",
		"git:commit-msg": "commitlint --config commitlint.config.cjs --edit",
		"git:lint-staged": "npm run test:lint",
		"git:unit-staged": "node --test",
		"git:test-staged": "npm run git:unit-staged",
		"lint": "biome check --write --no-errors-on-unmatched",
		"test:lint": "biome check --staged --no-errors-on-unmatched",
		"test:unit": "./bin/test-schemas",
		"test:types": "which tstyche > /dev/null 2>&1 && tstyche || echo 'tstyche not found, skipping type tests'",
		"test:sast": "npm run test:sast:license",
		"test:sast:license": "license-check-and-add check -f license.json"
	},
	"keywords": [
		"AWS",
		"Lambda",
		"JSON",
		"Schema",
		"Middy",
		"middyjs"
	],
	"author": "willfarrell",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		".github"
	],
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/willfarrell/aws-events.git"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/aws-events/issues"
	},
	"homepage": "https://github.com/willfarrell/aws-events#readme",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/willfarrell"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"ajv-cmd": "^0.7.0",
		"husky": "^9.0.0",
		"json-schema-test-esm": "^3.0.0",
		"license-check-and-add": "4.0.5"
	}
}
